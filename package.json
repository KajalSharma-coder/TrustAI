{
  "name": "trustai",
  "version": "0.1.0",
  "private": true,
  "description": "TrustAI - AI Output Verification System",
  "type": "module",
  "scripts": {
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "dev": "concurrently -n Backend,Frontend \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "postinstall": "npm --prefix client install --include=dev",
    "build": "npm --prefix client ci --include=dev && npm --prefix client run build",
    "compile": "hardhat compile"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "hardhat": "^3.14.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^17.4.2"
  }
}
